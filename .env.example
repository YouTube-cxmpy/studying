# Required. Create a key at https://platform.claude.com/ (Settings → API keys).
ANTHROPIC_API_KEY=

# Required in production: a long random string used to encrypt the Canvas
# session cookie. Generate with: openssl rand -hex 32
# In development a secret is generated and stored in .data/ if this is unset.
SESSION_SECRET=

# Optional. If set, visitors must enter this code before the app will use your
# API key. Strongly recommended for any deployment reachable from the internet.
APP_ACCESS_CODE=

# Optional. Model and effort used for generation.
STUDY_MODEL=claude-opus-5-5
STUDY_EFFORT=high

# Optional. Canvas OAuth ("Sign in with Canvas"). Needs a Developer Key issued
# by the school's Canvas admin, with redirect URI <APP_URL>/api/canvas/oauth/callback.
# Without these, students connect with a personal access token instead.
CANVAS_OAUTH_BASE_URL=
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
# Space-separated scopes; only needed if the Developer Key enforces scopes.
CANVAS_OAUTH_SCOPES=
# Public URL of this app, used to build the OAuth redirect URI.
APP_URL=http://localhost:3000
